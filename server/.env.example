PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/activemesh
CLIENT_URL=http://localhost:5173

# JWT Secrets (change these in production!)
ACCESS_TOKEN_SECRET=activemesh_access_secret_change_in_prod
REFRESH_TOKEN_SECRET=activemesh_refresh_secret_change_in_prod
QR_SECRET=activemesh_qr_secret_change_in_prod

# Email (Mailtrap for dev)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASS=your_mailtrap_pass
EMAIL_FROM=noreply@activemesh.com.au
